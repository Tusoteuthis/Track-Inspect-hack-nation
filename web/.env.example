# Copy to .env (gitignored). Everything is optional for the fixture demo; see README.md §2.

# Voice (server-side only; clients get short-lived tokens from /api/conversation-token)
ELEVENLABS_API_KEY=
# One ElevenLabs agent per flow (create in the dashboard, or `npm run sync-agents -- --create-missing`)
ELEVENLABS_AGENT_ID_EXPERT=
ELEVENLABS_AGENT_ID_TUTOR=

# Data locations (relative paths resolve against web/)
# KNOWLEDGE_DIR=../knowledge
# RUNTIME_DIR=.runtime
# EVALUATOR_DIR=.runtime/evaluator      # WS4 answer key: never served, never given to a module
# CASES_DIR=../cases/learner             # default: ../cases/learner if present, else fixtures/ws6/cases

# Partner modules: unset = real WS5 synthesis + stub tutor; stub = stub synthesis; real = real WS5 tutor too
# WS5_MODULES=
# ANTHROPIC_API_KEY=                     # only for WS5_MODULES=real (tutor judge)

# Demo access boundary for /api/* (LAN only; one shared secret; see README.md §5)
# BACKEND_ACCESS_TOKEN=

# ASSET_MAX_BYTES=15728640
